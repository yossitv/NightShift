# Night Shift MVP — Environment Variables

# GitHub — required for issue fetching and PR creation
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO_OWNER=your-org
GITHUB_REPO_NAME=your-repo

# Runner config
BRANCH_PREFIX=nightshift/
MAX_RETRIES=3

# Bland AI — optional, enables voice approval for high-risk missions
BLAND_API_KEY=
BLAND_PHONE_NUMBER=

# App base URL — used for webhook callbacks
NEXT_PUBLIC_BASE_URL=http://localhost:3000
